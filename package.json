{
  "name": "termometro-api",
  "version": "1.0.0",
  "description": "Backend do Termômetro Financeiro",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node --watch src/server.js",
    "dev:all": "bash scripts/dev-all.sh",
    "build": "node scripts/check-env.js && prisma generate && prisma migrate deploy",
    "start": "node scripts/check-env.js && node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:seed-dev": "node prisma/seed-dev.js",
    "db:backup": "bash scripts/backup-db.sh"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.0.0",
    "zod": "^3.23.8"
  }
}
